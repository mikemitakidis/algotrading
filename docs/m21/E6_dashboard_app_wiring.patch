+class RealAppWiring(unittest.TestCase):
+    """The real dashboard app serves the read-only view, OFF by default (approved E6 wiring)."""
+
+    def setUp(self):
+        import sys
+        for mod in ("dashboard.app", "dashboard"):
+            sys.modules.pop(mod, None)
+        self.env = mock.patch.dict(os.environ, {}, clear=False)
+        self.env.start()
+        os.environ.pop(V.DB_KEY, None)
+        from dashboard import app as app_mod
+        self.app = app_mod.app
+        self.app.config["TESTING"] = True
+        self.app.config.pop(V.DB_KEY, None)
+        self.client = self.app.test_client()
+
+    def tearDown(self):
+        self.env.stop()
+
+    def test_auth_then_off_by_default_and_no_write_route(self):
+        self.assertEqual(self.client.get("/api/template-controls").status_code, 401)
+        self.assertEqual(self.client.get("/template-controls").status_code, 401)
+        with self.client.session_transaction() as s:
+            s["authed"] = True
+            s["csrf_token"] = "tok"
+        self.assertEqual(self.client.get("/api/template-controls").status_code, 503)
+        for a in OLD_WRITE_ROUTES:
+            r = self.client.post("/api/template-controls/" + a, json={}, headers={"X-CSRF-Token": "tok"})
